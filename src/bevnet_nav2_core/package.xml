<?xml version="1.0"?>
<package format="3">
  <name>bevnet_nav2_core</name>
  <version>0.1.0</version>
  <description>BEVNet integration with Nav2 stack</description>
  <maintainer email="your_email@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- Dependencies (build + exec + test) -->
  <depend>rclcpp</depend>
  <depend>rclpy</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>nav2_core</depend>
  <depend>nav2_util</depend>
  <depend>pluginlib</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>bevnet_nav2_msgs</depend>
  <depend>angles</depend>
  
  <!-- Python dependencies -->
  <depend>python3-numpy</depend>
  <depend>python3-opencv</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_costmap_2d plugin="${prefix}/plugins.xml"/>
    <nav2_core plugin="${prefix}/plugins.xml"/>
  </export>
</package>